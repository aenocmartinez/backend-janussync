# Compose local. MySQL está instalado en el equipo anfitrión, fuera de Docker.
BACKEND_PORT=8080
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=janussync
DB_USER=janussync_app
DB_PASSWORD=
DB_SSL_MODE=DISABLED

# Directorio absoluto externo a Git. Contiene jwt-private.pem (PKCS#8) y jwt-public.pem.
JANUS_KEYS_DIR=
JANUS_JWT_ISSUER=janussync
JANUS_JWT_AUDIENCE=janussync-api
JANUS_ACCESS_TTL=PT5M
JANUS_REFRESH_TTL=P7D
# HTTP local heredado. compose.https.yaml impone cookie segura y URL HTTPS.
JANUS_COOKIE_SECURE=false
JANUS_ALLOW_NO_CAPTCHA_LOCAL=true
# En macOS, usar id -u e id -g para que el proceso no privilegiado lea tus claves 600.
JANUS_RUNTIME_UID=10001
JANUS_RUNTIME_GID=10001

# SMTP Sandbox: habilitar después de completar ambas credenciales.
MAIL_ENABLED=false
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=from@example.com
MAIL_FROM_NAME=JanusSync
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLED=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000
JANUS_FRONTEND_PUBLIC_URL=http://localhost:3000
JANUS_INVITATION_TTL=P7D
JANUS_RESET_TTL=PT60M
JANUS_EMAIL_COOLDOWN=PT1M

# Comprobaciones manuales de conectividad; secretos exclusivamente en .env local.
ACADEMUSOFT_MECANISMO=ORACLE
ACADEMUSOFT_ORACLE_URL=
ACADEMUSOFT_ORACLE_USERNAME=
ACADEMUSOFT_ORACLE_PASSWORD=
ACADEMUSOFT_PROGRAMAS_CONNECTION_TIMEOUT=PT5S
ACADEMUSOFT_PROGRAMAS_QUERY_TIMEOUT=PT10S
# real por defecto; mock solo con el perfil local, sin contactar al proveedor.
BRIGHTSPACE_MODE=real
BRIGHTSPACE_BASE_URL=
BRIGHTSPACE_API_VERSION=
# Credenciales Valence heredadas, ignoradas por el adaptador OAuth real.
BRIGHTSPACE_APP_ID=
BRIGHTSPACE_APP_KEY=
BRIGHTSPACE_USER_ID=
BRIGHTSPACE_USER_KEY=
JANUS_CONNECTION_TIMEOUT=PT3S
JANUS_CHECK_TIMEOUT=PT10S
JANUS_CHECK_COOLDOWN=PT1M
JANUS_CHECK_STALE_MINUTES=15

# Catálogo local de programas; tarea solo de lectura académica, coordinada entre instancias.
JANUS_PROGRAMAS_SYNC_ENABLED=true
JANUS_PROGRAMAS_SYNC_CRON=0 0 2 * * *
JANUS_PROGRAMAS_SYNC_ZONE=America/Bogota
JANUS_PROGRAMAS_MAX_AGE=PT48H
JANUS_PROGRAMAS_UPDATE_COOLDOWN=PT1M

# OAuth Authorization Code institucional. No usar APP_KEY/USER_KEY de Valence.
# Mantener BRIGHTSPACE_MODE=mock durante la autorización; cambiar explícitamente
# a real SOLO tras validar identidad. Scope mínimo whoami; registrarlo en D2L.
BRIGHTSPACE_OAUTH_CLIENT_ID=
BRIGHTSPACE_OAUTH_CLIENT_SECRET=
BRIGHTSPACE_OAUTH_REDIRECT_URI=https://janussync.test/callback
BRIGHTSPACE_OAUTH_SCOPES=users:own_profile:read
# Archivo base64 de 32 bytes AES, externo, montado por JANUS_KEYS_DIR.
# Completar solo después de crear el archivo; no regenerarlo con tokens guardados.
JANUS_OAUTH_KEY_FILE=
# Ejemplo de ruta interna: /run/keys/brightspace-oauth.key

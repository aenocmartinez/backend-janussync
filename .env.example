# Compose local. MySQL está instalado en el equipo anfitrión, fuera de Docker.
BACKEND_PORT=8080
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=janussync
DB_USER=janussync_app
DB_PASSWORD=
DB_SSL_MODE=DISABLED

# Credencial técnica temporal SOLO local, independiente de los usuarios del producto.
# Contraseña propia de 15 caracteres mínimo y 72 bytes máximo; nunca subir .env.
JANUS_LOCAL_USER=desarrollador
JANUS_LOCAL_PASSWORD=
